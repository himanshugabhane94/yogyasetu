# =============================================================================
# YogyaSetu (योग्यसेतु) — Environment Configuration Template
# =============================================================================

# 1. Database Configuration
# Local SQLite (Zero-config local development)
DATABASE_URL="file:./dev.db"

# Production PostgreSQL (Neon / Supabase)
# DATABASE_URL="postgresql://username:password@ep-host.region.aws.neon.tech/yogyasetu?sslmode=require"

# 2. NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_nextauth_secret_key_at_least_32_chars_long"

# 3. Gmail SMTP Configuration (Nodemailer for OTP Emails)
# Generate a Google App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-16-character-app-password"

# 4. Firebase Phone Authentication Configuration (Free Tier: 10 daily SMS / 10k monthly)
# Create a Firebase project at: https://console.firebase.google.com -> Project Settings -> General
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSy_your_firebase_api_key_here"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-app-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-app.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# 5. Google OAuth Configuration (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your_client_secret_here"

# 6. Optional AI Providers (System uses built-in rules engine by default)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GMAIL_USER=aapki_email@gmail.com
GMAIL_APP_PASSWORD=16letterpasswordbinaspace
